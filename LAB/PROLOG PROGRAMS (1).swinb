<div class="nb-cell program" name="p23">
% Dataset with two features: X and Y

data(2, 3).
data(3, 4).
data(4, 5).
data(5, 6).
data(6, 7).

% Calculate the mean of X and Y
mean_x(MX) :-
    findall(X, data(X, _), List),
    sum_list(List, Sum),
    length(List, N),
    MX is Sum / N.

mean_y(MY) :-
    findall(Y, data(_, Y), List),
    sum_list(List, Sum),
    length(List, N),
    MY is Sum / N.

% Center the data
centered(XC, YC) :-
    data(X, Y),
    mean_x(MX),
    mean_y(MY),
    XC is X - MX,
    YC is Y - MY.

% Display centered data
display_centered :-
    centered(X, Y),
    write('('), write(X), write(', '),
    write(Y), writeln(')'),
    fail.

display_centered.

% Simplified first principal component projection
pca_projection(PC) :-
    centered(X, Y),
    PC is (X + Y) / sqrt(2).
</div>

<div class="nb-cell program" name="p24">
% User ratings: rating(User, Item, Rating)

rating(user1, movie1, 5).
rating(user1, movie2, 4).
rating(user1, movie3, 1).

rating(user2, movie1, 5).
rating(user2, movie2, 4).
rating(user2, movie3, 2).

rating(user3, movie1, 1).
rating(user3, movie2, 2).
rating(user3, movie3, 5).
rating(user3, movie4, 4).

% Find users who have similar ratings for a common item
similar_users(U1, U2) :-
    rating(U1, Item, R1),
    rating(U2, Item, R2),
    U1 \= U2,
    abs(R1 - R2) =&lt; 1.

% Recommend items liked by similar users
recommend(User, Item) :-
    similar_users(User, OtherUser),
    rating(OtherUser, Item, Rating),
    Rating &gt;= 4,
    \+ rating(User, Item, _).
</div>

