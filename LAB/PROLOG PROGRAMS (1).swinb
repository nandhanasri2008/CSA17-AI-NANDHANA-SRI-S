<div class="nb-cell program" name="p26">
% Data points
point(1, 2).
point(2, 3).
point(3, 2).
point(8, 8).
point(9, 9).
point(8, 9).

% Initial cluster centers
centroid(1, 2, 2).
centroid(2, 8, 8).

% Calculate Euclidean distance
distance(X1, Y1, X2, Y2, D) :-
    D is sqrt((X1-X2)*(X1-X2) +
              (Y1-Y2)*(Y1-Y2)).

% Find the nearest cluster
assign_cluster(X, Y, Cluster) :-
    centroid(1, X1, Y1),
    centroid(2, X2, Y2),
    distance(X, Y, X1, Y1, D1),
    distance(X, Y, X2, Y2, D2),
    (D1 =&lt; D2 -&gt; Cluster = 1 ; Cluster = 2).

% Display clustered data points
show_clusters :-
    point(X, Y),
    assign_cluster(X, Y, C),
    write('Point ('), write(X), write(','),
    write(Y), write(') belongs to Cluster '),
    writeln(C),
    fail.

show_clusters.
</div>

<div class="nb-cell program" name="p27">
% Environment: A simple path from position 1 to position 5

goal(5).

% Possible actions
move(1, right, 2).
move(2, right, 3).
move(3, right, 4).
move(4, right, 5).

% Rewards
reward(5, 10).
reward(_, -1).

% Agent learns by moving towards the goal
learn(Position, Path, TotalReward) :-
    goal(Position),
    Path = [Position],
    TotalReward = 10.

learn(Position, [Position|Rest], TotalReward) :-
    move(Position, right, Next),
    learn(Next, Rest, NextReward),
    reward(Position, R),
    TotalReward is R + NextReward.

% Start training
train :-
    learn(1, Path, Reward),
    write('Learned Path: '),
    writeln(Path),
    write('Total Reward: '),
    writeln(Reward).
</div>

<div class="nb-cell program" name="p28">
% Image represented as a matrix of pixel intensity values
% 0 = Black, 255 = White

image([
    [10, 20, 200, 210],
    [15, 25, 205, 215],
    [30, 40, 220, 230],
    [35, 45, 225, 235]
]).

% Threshold-based segmentation
% Pixel intensity &gt;= 128 is foreground (1)
% Pixel intensity &lt; 128 is background (0)

segment_pixel(Pixel, 1) :-
    Pixel &gt;= 128.

segment_pixel(Pixel, 0) :-
    Pixel &lt; 128.

% Segment each row
segment_row([], []).

segment_row([Pixel|Rest], [Segment|Result]) :-
    segment_pixel(Pixel, Segment),
    segment_row(Rest, Result).

% Segment the complete image
segment_image([], []).

segment_image([Row|Rest], [SegmentedRow|Result]) :-
    segment_row(Row, SegmentedRow),
    segment_image(Rest, Result).

% Display segmented image
display_segmentation :-
    image(Image),
    segment_image(Image, Result),
    write('Segmented Image:'), nl,
    writeln(Result).
</div>

<div class="nb-cell program" name="p29">
