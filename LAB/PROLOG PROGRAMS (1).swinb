11.<div class="nb-cell program" name="p11">
% Graph connections
edge(a, b).
edge(a, c).
edge(b, d).
edge(b, e).
edge(c, f).
edge(c, g).

% Heuristic values
h(a, 6).
h(b, 4).
h(c, 2).
h(d, 5).
h(e, 3).
h(f, 1).
h(g, 0).

% Best First Search
best_first(Start, Goal, Path) :-
    search([[Start]], Goal, RevPath),
    reverse(RevPath, Path).

search([[Goal|Path]|_], Goal, [Goal|Path]).

search([ [Node|Path] | Rest], Goal, Result) :-
    findall([Next,Node|Path],
        (edge(Node, Next),
         \+ member(Next, [Node|Path])),
        Children),
    append(Rest, Children, NewQueue),
    sort_queue(NewQueue, SortedQueue),
    search(SortedQueue, Goal, Result).

sort_queue(Queue, Sorted) :-
    predsort(compare_nodes, Queue, Sorted).

compare_nodes(Order, [A|_], [B|_]) :-
    h(A, HA),
    h(B, HB),
    compare(Order, HA, HB).
</div>

12.<div class="nb-cell program" name="p12">
% Medical Diagnosis System

% Symptoms
symptom(ram, fever).
symptom(ram, cough).

symptom(raj, fever).
symptom(raj, headache).

symptom(anu, sneezing).
symptom(anu, cough).

% Diagnosis Rules
disease(Person, flu) :-
    symptom(Person, fever),
    symptom(Person, cough).

disease(Person, cold) :-
    symptom(Person, sneezing),
    symptom(Person, cough).

disease(Person, viral_fever) :-
    symptom(Person, fever),
    symptom(Person, headache).
</div>

13.<div class="nb-cell program" name="p13">
% Facts
fact(sun).
fact(water).

% Rules
rule(plant_grows, [sun, water]).
rule(food_produced, [plant_grows]).

% Forward Chaining
forward :-
    rule(NewFact, Conditions),
    \+ fact(NewFact),
    check_all(Conditions),
    assertz(fact(NewFact)),
    write('New Fact: '),
    write(NewFact), nl,
    fail.

forward.

% Check conditions
check_all([]).
</div>

14.<div class="nb-cell program" name="p14">
% Facts
fact(sun).
fact(water).

% Rules
rule(plant_grows) :-
    fact(sun),
    fact(water).

rule(food_produced) :-
    rule(plant_grows).

% Backward Chaining
backward(Goal) :-
    fact(Goal).

backward(Goal) :-
    rule(Goal).
</div>
