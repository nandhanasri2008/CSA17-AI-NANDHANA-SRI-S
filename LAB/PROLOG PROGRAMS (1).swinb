    writeln(Confidence).
</div>

<div class="nb-cell program" name="p33">
% Initial population of neural network weights
% Each network has two weights: W1 and W2

network(net1, 1, 1).
network(net2, 2, 1).
network(net3, 1, 2).
network(net4, 3, 2).

% XOR training examples
xor(0, 0, 0).
xor(0, 1, 1).
xor(1, 0, 1).
xor(1, 1, 0).

% Neural network output (simplified model)
predict(X, Y, W1, W2, Output) :-
    Sum is X * W1 + Y * W2,
    (Sum &gt;= 2 -&gt; Output = 1 ; Output = 0).

% Calculate fitness
fitness(W1, W2, Fitness) :-
    findall(1,
        (xor(X, Y, Expected),
         predict(X, Y, W1, W2, Actual),
         Actual =:= Expected),
        Results),
    length(Results, Fitness).

% Find the best network
best_network(Name, W1, W2, Fitness) :-
    network(Name, W1, W2),
    fitness(W1, W2, Fitness),
    \+ (network(_, A, B),
        fitness(A, B, F),
        F &gt; Fitness).

% Display the best network
evolve :-
    best_network(Name, W1, W2, Fitness),
    write('Best Network: '), writeln(Name),
    write('Weight 1: '), writeln(W1),
    write('Weight 2: '), writeln(W2),
    write('Fitness: '), writeln(Fitness).
</div>

</div>
