detect_objects(Image) :-
    object(Image, Object, Confidence),
    write('Detected Object: '),
    write(Object),
    write(', Confidence: '),
    write(Confidence),
    nl,
    fail.

detect_objects(_).

% Check whether a particular object is detected
check_object(Image, Object) :-
    object(Image, Object, Confidence),
    write('Object Found: '),
    write(Object),
    write(', Confidence: '),
    writeln(Confidence).
</div>

<div class="nb-cell program" name="p30">
