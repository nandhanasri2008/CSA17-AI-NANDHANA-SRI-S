symptom(ram, cough).

symptom(raj, fever).
symptom(raj, headache).

symptom(anu, sneezing).
symptom(anu, cough).

% Diagnosis Rules
disease(Person, flu) :-
    symptom(Person, fever),
    symptom(Person, cough).

disease(Person, cold) :-
    symptom(Person, sneezing),
    symptom(Person, cough).

disease(Person, viral_fever) :-
    symptom(Person, fever),
    symptom(Person, headache).
</div>

<div class="nb-cell program" name="p13">
% Facts
fact(sun).
fact(water).

% Rules
rule(plant_grows, [sun, water]).
rule(food_produced, [plant_grows]).

% Forward Chaining
forward :-
    rule(NewFact, Conditions),
    \+ fact(NewFact),
    check_all(Conditions),
    assertz(fact(NewFact)),
    write('New Fact: '),
    write(NewFact), nl,
    fail.

forward.

% Check conditions
check_all([]).
</div>

<div class="nb-cell program" name="p14">
% Facts
fact(sun).
fact(water).

% Rules
rule(plant_grows) :-
    fact(sun),
    fact(water).

rule(food_produced) :-
    rule(plant_grows).

% Backward Chaining
backward(Goal) :-
    fact(Goal).

backward(Goal) :-
    rule(Goal).
</div>

