<div class="nb-cell program" name="p17">
% KNN Classification

% Training data
point(1, 2, red).
point(2, 3, red).
point(3, 3, red).
point(6, 7, blue).
point(7, 8, blue).
point(8, 8, blue).

% Calculate Euclidean distance
distance(X1, Y1, X2, Y2, D) :-
    D is sqrt((X1-X2)^2 + (Y1-Y2)^2).

% Find nearest class (simple classification)
classify(X, Y, Class) :-
    findall(D-C,
        (point(A, B, C),
         distance(X, Y, A, B, D)),
        List),
    sort(List, [_-Class|_]).
</div>

