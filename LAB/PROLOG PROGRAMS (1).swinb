<div class="nb-cell program" name="p21">
% Genetic Algorithm

% Initial Population
population([1, 3, 5, 7, 9, 10]).

% Fitness Function
fitness(X, F) :-
    F is X * X.

% Find Best Individual
best(X, Y) :-
    fitness(X, F1),
    fitness(Y, F2),
    F1 &gt;= F2.

% Select Best Individual
select_best(List, Best) :-
    max_member(Best, List).

% Display Result
genetic_algorithm :-
    population(P),
    select_best(P, Best),
    fitness(Best, Fitness),
    write('Best Individual: '), write(Best), nl,
    write('Maximum Fitness: '), write(Fitness), nl.
</div>

<div class="nb-cell program" name="p22">
