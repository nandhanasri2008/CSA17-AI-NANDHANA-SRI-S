model_accuracy(0.01, 75).
model_accuracy(0.05, 85).
model_accuracy(0.10, 92).
model_accuracy(0.15, 88).
model_accuracy(0.20, 80).

% Find the best hyperparameter
best_parameter(Parameter, Accuracy) :-
    model_accuracy(Parameter, Accuracy),
    \+ (model_accuracy(_, OtherAccuracy),
        OtherAccuracy &gt; Accuracy).

% Display all parameter results
display_results :-
    model_accuracy(Parameter, Accuracy),
    write('Learning Rate: '),
    write(Parameter),
    write(', Accuracy: '),
    write(Accuracy),
    writeln('%'),
    fail.

display_results.
</div>

<div class="nb-cell program" name="p31">
% Bayesian Network:
% Cloudy -&gt; Rain
% Cloudy -&gt; Sprinkler
% Rain and Sprinkler -&gt; Wet Grass

% Prior probability
probability(cloudy, true, 0.5).
probability(cloudy, false, 0.5).

% Conditional probability of Rain
probability(rain, true, cloudy, 0.8).
probability(rain, false, cloudy, 0.2).

probability(rain, true, not_cloudy, 0.2).
probability(rain, false, not_cloudy, 0.8).

% Conditional probability of Sprinkler
probability(sprinkler, true, cloudy, 0.1).
probability(sprinkler, false, cloudy, 0.9).

probability(sprinkler, true, not_cloudy, 0.5).
probability(sprinkler, false, not_cloudy, 0.5).

% Conditional probability of Wet Grass
probability(wet_grass, true, true, true, 0.99).
probability(wet_grass, true, true, false, 0.90).
probability(wet_grass, true, false, true, 0.90).
probability(wet_grass, true, false, false, 0.01).

% Query probability of cloudy weather
query_cloudy(P) :-
    probability(cloudy, true, P).

% Query probability of rain given cloudy weather
query_rain(P) :-
    probability(rain, true, cloudy, P).

% Query probability of wet grass
query_wet_grass(Rain, Sprinkler, P) :-
    probability(wet_grass, true, Rain, Sprinkler, P).
</div>

<div class="nb-cell program" name="p32">
% Sample face recognition database
% face(Person, Face_ID, Confidence)

face(person1, face101, 0.98).
face(person2, face102, 0.95).
face(person3, face103, 0.92).

% Recognize a face using its ID
