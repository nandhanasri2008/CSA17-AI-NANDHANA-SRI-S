<div class="nb-cell program" name="p7">
% Facts
male(ravi).
male(kumar).
male(arun).

female(lakshmi).
female(priya).
female(divya).

% Parent relationships
parent(ravi, kumar).
parent(lakshmi, kumar).
parent(kumar, arun).
parent(priya, arun).

% Rules
father(X, Y) :-
    male(X),
    parent(X, Y).

mother(X, Y) :-
    female(X),
    parent(X, Y).

grandparent(X, Y) :-
    parent(X, Z),
    parent(Z, Y).

sibling(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    X \= Y.
</div>

