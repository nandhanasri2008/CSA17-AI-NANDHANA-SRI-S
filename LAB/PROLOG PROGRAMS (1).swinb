data(3, 2, 0).
data(6, 5, 1).
data(7, 6, 1).
data(8, 5, 1).

% SVM decision boundary: X + Y = 8

classify(X, Y, 1) :-
    X + Y &gt;= 8.

classify(X, Y, 0) :-
